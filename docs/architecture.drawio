<mxfile host="Handoff" agent="scripts/make_drawio_architecture.py" version="24.7.17"><diagram id="handoff-architecture" name="Handoff architecture"><mxGraphModel dx="1240" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;Handoff&lt;/b&gt; &amp;nbsp;·&amp;nbsp; autonomous workflows with a human decision gate&lt;br&gt;&lt;span style='font-size:11px;color:#6B7280'&gt;Strands Agents SDK · Amazon Bedrock · Bedrock AgentCore · one DynamoDB table · EventBridge → Lambda → Runtime&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="c3" value="You — three surfaces, one gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=6;container=1;collapsible=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="560" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Talk&lt;/b&gt;&lt;br&gt;the orb — speak the chore&lt;br&gt;&lt;span style='font-size:10px'&gt;web/orb · Transcribe in, Polly out&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="40" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Desktop window&lt;/b&gt;&lt;br&gt;pywebview (WebView2 / WebKit / GTK)&lt;br&gt;&lt;span style='font-size:10px'&gt;handoff desktop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="125" width="220" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;FastAPI + Jinja · SSE streaming&lt;br&gt;&lt;span style='font-size:10px'&gt;handoff serve&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="210" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Terminal&lt;/b&gt;&lt;br&gt;handoff run --watch · pending · decide&lt;br&gt;&lt;span style='font-size:10px'&gt;pipx install handoff&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="295" width="220" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Decision screen&lt;/b&gt;&lt;br&gt;one screen, one decision&lt;br&gt;each item its own choice, “and 2 more after this”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=12;fontStyle=1;arcSize=12;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="400" width="220" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style='font-size:10px;color:#6B7280'&gt;No AWS account? The same loop runs on a scripted offline model and JSON files.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="c3"><mxGeometry x="20" y="495" width="220" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Agents — Strands Agents SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=6;container=1;collapsible=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="560" height="560" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Builder&lt;/b&gt; · conversational&lt;br&gt;one sentence → workflow config&lt;br&gt;&lt;span style='font-size:10px'&gt;validate · preview · save&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c10"><mxGeometry x="20" y="40" width="240" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Assistant&lt;/b&gt; · Strands session&lt;br&gt;RepositorySessionManager → store&lt;br&gt;&lt;span style='font-size:10px'&gt;every MCP server that is connected&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c10"><mxGeometry x="290" y="40" width="250" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Executor&lt;/b&gt; — Strands Graph (deterministic edges, replayable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=6;container=1;collapsible=0;dashed=0;" vertex="1" parent="c10"><mxGeometry x="20" y="130" width="520" height="200" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;trigger&lt;/b&gt;&lt;br&gt;cron · event · webhook&lt;br&gt;&lt;span style='font-size:10px'&gt;triggered:false → stop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c13"><mxGeometry x="20" y="40" width="140" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;executor&lt;/b&gt;&lt;br&gt;fetch → classify → act&lt;br&gt;&lt;span style='font-size:10px'&gt;confidence per item&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c13"><mxGeometry x="190" y="40" width="140" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;completer&lt;/b&gt;&lt;br&gt;audit · summary&lt;br&gt;&lt;span style='font-size:10px'&gt;writes the run record&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c13"><mxGeometry x="360" y="40" width="140" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;HITL gate&lt;/b&gt; — BeforeToolCallEvent on submit_action / finish_batch&lt;br&gt;ALWAYS_GATED → ask &amp;nbsp;·&amp;nbsp; confidence &amp;lt; threshold → defer &amp;nbsp;·&amp;nbsp; one interrupt per pass&lt;br&gt;&lt;span style='font-size:10px'&gt;event.interrupt(reason=…) suspends one tool call; graph.serialize_state() survives a restart&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c13"><mxGeometry x="20" y="125" width="480" height="60" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#374151;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="c13" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#374151;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="c13" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Learner&lt;/b&gt; · one-shot&lt;br&gt;decision + note → narrow rule&lt;br&gt;&lt;span style='font-size:10px'&gt;exact sender · domain · ≥2 keywords&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c10"><mxGeometry x="20" y="350" width="240" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Store&lt;/b&gt; · one interface, two backends&lt;br&gt;JSON files on the desktop · DynamoDB deployed&lt;br&gt;&lt;span style='font-size:10px'&gt;19 collections · pk=collection, sk=id → Query, never Scan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c10"><mxGeometry x="290" y="350" width="250" height="70" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Model chain&lt;/b&gt; · HANDOFF_MODEL_PROVIDER&lt;br&gt;Bedrock → Anthropic → Groq, same agent code&lt;br&gt;&lt;span style='font-size:10px'&gt;ResilientOpenAIModel repairs slipped tool-JSON&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c10"><mxGeometry x="20" y="440" width="520" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;span style='font-size:10px;color:#6B7280'&gt;Graph, not Swarm: a job that files tickets in your name at 08:00 must take the same path every time.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="c10"><mxGeometry x="20" y="510" width="520" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Tools — MCP servers · read &amp;amp; act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=6;container=1;collapsible=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="250" height="560" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Gmail&lt;/b&gt; · 19 tools&lt;br&gt;&lt;span style='font-size:10px'&gt;own OAuth · token file&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="40" width="210" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;LINEAR_API_KEY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="102" width="210" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;GITHUB_TOKEN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="164" width="210" height="50" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Notion&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;NOTION_API_KEY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="226" width="210" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Airtable&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;AIRTABLE_API_KEY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="288" width="210" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;bot token or webhook&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="350" width="210" height="50" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;fetch&lt;/b&gt; · credential-free&lt;br&gt;&lt;span style='font-size:10px'&gt;read any web page&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#232F3E;fontSize=12;fontStyle=0;arcSize=12;spacing=6;" vertex="1" parent="c24"><mxGeometry x="20" y="412" width="210" height="50" as="geometry"/></mxCell><mxCell id="c32" value="&lt;span style='font-size:10px;color:#6B7280'&gt;Unconfigured server → skipped, run continues. Duplicate tool names (Linear/GitHub list_issues) → first named wins.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="c24"><mxGeometry x="20" y="480" width="210" height="70" as="geometry"/></mxCell><mxCell id="c33" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1150" height="330" as="geometry"/></mxCell><mxCell id="c34" value="ap-northeast-2 (Seoul)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verti