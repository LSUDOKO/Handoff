# ==========================================================================
# Handoff — environment configuration
# Copy to .env and fill in. Never commit .env.
#
# The defaults below run the whole product offline with synthetic data and no
# AWS account. Change USE_MOCK_TOOLS and the AWS block when you want it live.
# ==========================================================================

# --- Offline mode ---------------------------------------------------------
# true  = deterministic scripted model, no Bedrock calls, no credentials needed
# false = real Bedrock (requires AWS credentials + model access)
HANDOFF_FAKE_MODEL=false

# true  = synthetic inbox and mocked integrations
# false = real MCP servers (Gmail, Linear, Slack) using the tokens below
USE_MOCK_TOOLS=true

# Where local JSON state lives when DynamoDB is off.
HANDOFF_STATE_DIR=.handoff-state

# --- Which model provider actually runs the agents -----------------------
# bedrock   = AWS Bedrock. What the AgentCore deployment uses.
# anthropic = Anthropic API directly. One key, no AWS account needed.
# groq      = Groq (OpenAI-compatible). Free tier, fast, also serves the
#             speech models that make voice real. One key.
# Run `handoff doctor` after setting any — it makes a real call.
HANDOFF_MODEL_PROVIDER=bedrock

# --- Groq (only when HANDOFF_MODEL_PROVIDER=groq) ------------------------
# console.groq.com -> API keys. Free tier: 8K tokens/min, 200K/day per model.
GROQ_API_KEY=
GROQ_MODEL_ID=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL_ID=openai/gpt-oss-20b
# Groq speech (used when HANDOFF_SPEECH_PROVIDER resolves to groq). Orpheus
# needs a one-time terms acceptance in the Groq console playground.
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# --- Speech -----------------------------------------------------------------
# What hears you on the Talk page and speaks back.
#   auto    = AWS (Transcribe streaming + Polly) when AWS credentials resolve,
#             else Groq when a key is set, else the browser's own engines
#   aws | groq | browser = force one
# AWS speech costs $0.024 per minute heard and $16 per million characters
# spoken; a full demo is cents. Check it with: handoff doctor speech
HANDOFF_SPEECH_PROVIDER=auto
POLLY_VOICE=Matthew
POLLY_ENGINE=neural
TRANSCRIBE_LANGUAGE=en-US

# --- Anthropic (only when HANDOFF_MODEL_PROVIDER=anthropic) --------------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
ANTHROPIC_FALLBACK_MODEL_ID=claude-haiku-4-5-20251001

# The executor reasons over a whole inbox in one turn, so give it room.
HANDOFF_MODEL_MAX_TOKENS=8192

# --- AWS ------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- Bedrock models -------------------------------------------------------
# Confirm availability in your region before deploying:
# https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Persistence ----------------------------------------------------------
USE_DYNAMODB=false
DDB_TABLE=handoff

# --- AgentCore Memory -----------------------------------------------------
# Created by infra/memory_setup.py; paste the id it prints.
USE_AGENTCORE_MEMORY=false
AGENTCORE_MEMORY_ID=

# --- The interrupt gate ---------------------------------------------------
# Below this confidence, Handoff stops and asks instead of acting.
# Raise it to be asked more often; lower it to be asked less.
CONFIDENCE_THRESHOLD=0.7

# --- Notifications --------------------------------------------------------
# console | slack | sns
NOTIFY_CHANNEL=console
SLACK_WEBHOOK_URL=
SNS_TOPIC_ARN=

# --- UI -------------------------------------------------------------------
# Used to build the deep link in "a decision is waiting" notifications.
UI_BASE_URL=http://localhost:8000
UI_PORT=8000

# --- Observability --------------------------------------------------------
STRANDS_OTEL_ENABLE=false
# console | otlp  (otlp -> CloudWatch when running on AgentCore)
STRANDS_OTEL_EXPORTER=console

# --- Integration credentials (only when USE_MOCK_TOOLS=false) ------------
# In-studio these are unnecessary: the daemon holds the OAuth and hands
# Handoff already-authenticated tools. These are for the standalone UI.
#
# Verify every one of them with: handoff doctor

# Gmail needs no key here. Its MCP server does its own one-time browser
# sign-in and refreshes itself forever after — connect it from the
# Credentials page, or: npx -y @gongrzhe/server-gmail-autoauth-mcp auth
# (after saving your OAuth client JSON to ~/.gmail-mcp/gcp-oauth.keys.json)

# Linear -> Settings -> API -> Personal API keys. Used raw, no "Bearer".
LINEAR_API_KEY=

# Either is enough. A bot token (xoxb-...) reports real delivery errors and
# can post anywhere it's invited; a webhook is faster to create but is bound
# to one channel and returns 200 even when nobody sees the message.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# github.com/settings/tokens -> fine-grained token with repo + issues access
GITHUB_TOKEN=
